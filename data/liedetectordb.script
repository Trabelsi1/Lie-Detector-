CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.CHAT_MESSAGE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CONTENT VARCHAR(255),SENT_AT TIMESTAMP,ROUND_ID BIGINT,SENDER_ID BIGINT)
ALTER TABLE PUBLIC.CHAT_MESSAGE ALTER COLUMN ID RESTART WITH 8
CREATE MEMORY TABLE PUBLIC.GAME(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CURRENT_CYCLE INTEGER DEFAULT 1 NOT NULL,CURRENT_ROUND_INDEX INTEGER DEFAULT 0 NOT NULL,CYCLE_START_PLAYER_COUNT INTEGER DEFAULT 0 NOT NULL,END_TIME TIMESTAMP,PROFILE_STATS_APPLIED BOOLEAN DEFAULT FALSE NOT NULL,SPEAKERS_COMPLETED_IN_CYCLE INTEGER DEFAULT 0 NOT NULL,START_TIME TIMESTAMP,STATUS VARCHAR(255),TARGET_CYCLES INTEGER DEFAULT 2 NOT NULL,GAME_ROOM_ID BIGINT)
ALTER TABLE PUBLIC.GAME ALTER COLUMN ID RESTART WITH 7
CREATE MEMORY TABLE PUBLIC.GAME_ROOM_PLAYERS(ROOM_ID BIGINT NOT NULL,PLAYER_ID BIGINT NOT NULL,PLAYER_ORDER INTEGER NOT NULL,PRIMARY KEY(ROOM_ID,PLAYER_ORDER))
CREATE MEMORY TABLE PUBLIC.GAME_ROOM(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP,MAX_PLAYERS INTEGER NOT NULL,ROOM_CODE VARCHAR(255),STATUS VARCHAR(255))
ALTER TABLE PUBLIC.GAME_ROOM ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.INVITATION(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,SENT_AT TIMESTAMP,STATUS VARCHAR(255),GAME_ROOM_ID BIGINT,RECEIVER_ID BIGINT,SENDER_ID BIGINT,CONSTRAINT FK60CDYS0TXB0AY0CP5HT7H0D1F FOREIGN KEY(GAME_ROOM_ID) REFERENCES PUBLIC.GAME_ROOM(ID))
ALTER TABLE PUBLIC.INVITATION ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.PLAYER(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,USER_ID BIGINT,CONSTRAINT UKFPXWFE7N29RWSBYU5P1WL2MQ1 UNIQUE(USER_ID))
ALTER TABLE PUBLIC.PLAYER ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.PLAYER_PROFILE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,ARCHETYPE VARCHAR(255),DECEPTION_RATE DOUBLE NOT NULL,DETECTION_RATE DOUBLE NOT NULL,TOTAL_GAMES INTEGER NOT NULL,TOTAL_LOSSES INTEGER DEFAULT 0 NOT NULL,TOTAL_PLAYERS_FOOLED INTEGER NOT NULL,TOTAL_WINS INTEGER NOT NULL,PLAYER_ID BIGINT NOT NULL,CONSTRAINT UKP3V9UWUEXY547B3TIP0U5XA6K UNIQUE(PLAYER_ID),CONSTRAINT FKAXI8CD1JW02WW8CGBP2N6WGI FOREIGN KEY(PLAYER_ID) REFERENCES PUBLIC.PLAYER(ID))
ALTER TABLE PUBLIC.PLAYER_PROFILE ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.ROUND(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,ENDED_AT TIMESTAMP,PHASE VARCHAR(255),ROUND_NUMBER INTEGER NOT NULL,SPEAKER_ID BIGINT,STARTED_AT TIMESTAMP,GAME_ID BIGINT,CONSTRAINT FKPPXONWN9E98LCCY46M2EVE67M FOREIGN KEY(GAME_ID) REFERENCES PUBLIC.GAME(ID),CONSTRAINT FKI0GNQT5ODWGKKG60UABW5962O FOREIGN KEY(SPEAKER_ID) REFERENCES PUBLIC.PLAYER(ID))
ALTER TABLE PUBLIC.ROUND ALTER COLUMN ID RESTART WITH 15
CREATE MEMORY TABLE PUBLIC.SCORE_ENTRY(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CORRECT_GUESSES INTEGER NOT NULL,PLAYERS_FOOLED INTEGER NOT NULL,POINTS INTEGER NOT NULL,GAME_ID BIGINT,PLAYER_ID BIGINT,CONSTRAINT FKNGGQR1HFS7VMM561WIMUXH6JP FOREIGN KEY(GAME_ID) REFERENCES PUBLIC.GAME(ID),CONSTRAINT FKC34IK22N1FKDOHCXKHQ5CP9LG FOREIGN KEY(PLAYER_ID) REFERENCES PUBLIC.PLAYER(ID))
ALTER TABLE PUBLIC.SCORE_ENTRY ALTER COLUMN ID RESTART WITH 9
CREATE MEMORY TABLE PUBLIC.STATEMENT(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CONTENT VARCHAR(255),IS_LIE BOOLEAN NOT NULL,POSITION INTEGER NOT NULL,ROUND_ID BIGINT,CONSTRAINT FK501WVJYM6Y6BWQPUVMHGYJS82 FOREIGN KEY(ROUND_ID) REFERENCES PUBLIC.ROUND(ID))
ALTER TABLE PUBLIC.STATEMENT ALTER COLUMN ID RESTART WITH 62
CREATE MEMORY TABLE PUBLIC.USER(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP,EMAIL VARCHAR(255),PASSWORD VARCHAR(255),USERNAME VARCHAR(255))
ALTER TABLE PUBLIC.USER ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.VOTE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,VOTED_AT TIMESTAMP,ROUND_ID BIGINT,STATEMENT_ID BIGINT,VOTER_ID BIGINT,CONSTRAINT FK4SJ2C98OSOB9GSL354CIQHJI1 FOREIGN KEY(ROUND_ID) REFERENCES PUBLIC.ROUND(ID),CONSTRAINT FKF4FALLCFIRC5QKD8BPIDWXY2S FOREIGN KEY(STATEMENT_ID) REFERENCES PUBLIC.STATEMENT(ID),CONSTRAINT FKFS3VMNMDPPTVF9QHCY3J6CYRA FOREIGN KEY(VOTER_ID) REFERENCES PUBLIC.PLAYER(ID))
ALTER TABLE PUBLIC.VOTE ALTER COLUMN ID RESTART WITH 12
